# ─────────────────────────────────────────────────────────────
#  Güler.dev – Umgebungsvariablen
#  Kopiere diese Datei zu ".env.local" und trage echte Werte ein.
#  .env.local wird NICHT committet (siehe .gitignore).
# ─────────────────────────────────────────────────────────────

# Resend API-Key für den E-Mail-Versand des Kontaktformulars.
# Kostenlos erstellen unter: https://resend.com  →  API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Absender-Adresse für ausgehende Mails.
# WICHTIG: Diese Domain muss bei Resend verifiziert sein (DNS-Eintrag).
# Zum Testen kannst du "onboarding@resend.dev" nutzen.
RESEND_FROM="Güler.dev <kontakt@deine-domain.de>"

# Empfänger-Adresse: hierhin gehen die Kontaktanfragen.
CONTACT_EMAIL=fatih.gueler75@gmail.com

# Öffentliche Basis-URL der Seite (für SEO / Sitemap / Open Graph).
NEXT_PUBLIC_SITE_URL=https://guler.dev
